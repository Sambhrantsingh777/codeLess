<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>codeLess</AssemblyName>
    <RootNamespace>codeLess.AvaloniaApp</RootNamespace>
    <Nullable>disable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Version>3.3.5</Version>
    <Company>Savatarr</Company>
    <Product>codeLess</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Desktop IDE: workstation GC, and compact more aggressively so RSS shrinks back after bursts of terminal output. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\codeLess.Core\codeLess.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\savatarr_bolt.png" Link="assets\savatarr_bolt.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\assets\savatarr_bolt.png')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
  </ItemGroup>
</Project>
